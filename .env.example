# Required server configuration
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DATABASE_SSL="true"

# Firebase Admin credentials (choose one form)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# or:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Authentication policy
REQUIRE_MFA_CLAIM="false"
RECENT_AUTH_SECONDS="600"
ALLOW_UNVERIFIED_EMAIL="false"

# Deployment
PORT="3000"
CORS_ORIGINS=""
TRUST_PROXY="true"
LOG_LEVEL="info"

# Isolated demo tenant (run `npm run db:seed` after enabling)
DEMO_MODE="false"
SEED_INVITES='[{"email":"president@example.edu","role":"tenant_admin","title":"President","governingBodyAffiliation":"Office of the President"},{"email":"senate.chair@example.edu","role":"academic_leader","title":"Faculty Senate Chair","governingBodyAffiliation":"Faculty Senate"}]'

# Optional AI-assisted scenario drafting. Deterministic templates are used otherwise.
ENABLE_AI="false"
GEMINI_API_KEY=""

# Client-side Firebase web configuration (Vite)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_API_BASE="/api/v1"
