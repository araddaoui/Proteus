# Proteus runs in DETERMINISTIC (key-free) mode by default. No AI provider is
# contacted and no API key is required for the core governance platform. Scenario
# drafts are produced from the built-in Compass templates.

# ENABLE_AI: Set to "true" to opt in to AI-assisted scenario generation.
# AI is only active when ENABLE_AI="true" AND GEMINI_API_KEY is present.
# Leave unset (or any value other than "true") to stay fully deterministic.
ENABLE_AI="false"

# GEMINI_API_KEY: OPTIONAL. Only used when ENABLE_AI="true".
# When AI is disabled, this key is ignored and no external call is made.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
